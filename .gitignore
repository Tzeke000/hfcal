# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
# Root-anchored: this used to be a bare 'build/' which matched
# scripts/validation/build/ anywhere in the tree and silently kept a NEW
# build script out of git — three deploys failed on the docs guard before
# anyone noticed the file had never been pushed.
/build/
out/

# Capacitor — generated platforms (regenerated by CI)
android/
ios/

# Tauri / Rust — build artifacts (regenerated by CI)
src-tauri/target/
src-tauri/Cargo.lock
src-tauri/gen/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Environment
.env
.env.local
.env.*.local

# Misc
.cache/
.parcel-cache/
*.tsbuildinfo
__pycache__/

# Validation INTERMEDIATES — regenerable, and large enough to dominate the repo.
# fof2-grid.json (47 MB) is the raw VOACAP sweep that build_fof2_table.py turns
# into src/fof2Table's binary; mfactor-rows.json (39 MB) is the raw sweep behind
# src/mfactorTable.js. Both are rebuilt by the scripts in scripts/validation/,
# and the FITTED products they produce are committed. Every RESULT file — the
# numbers this project's claims rest on — stays in the repo.
docs/validation/fof2-grid.json
docs/validation/mfactor-rows.json
